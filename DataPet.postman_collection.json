        { "name": "Actualizar veterinario", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Camila Torres Actualizada\",\n  \"registroProfesional\": \"MV-{{$timestamp}}\",\n  \"especialidad\": \"Medicina general\",\n  \"telefono\": \"3101234567\",\n  \"correo\": \"vet-{{$timestamp}}@example.com\"\n}" }, "url": "{{baseUrl}}/api/v1/veterinarios/{{veterinarioId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Actualizar mascota", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Luna Actualizada\",\n  \"especie\": \"Perro\",\n  \"raza\": \"Labrador\",\n  \"fechaNacimiento\": \"2022-05-10\",\n  \"sexo\": \"HEMBRA\",\n  \"clienteId\": {{clienteId}}\n}" }, "url": "{{baseUrl}}/api/v1/mascotas/{{mascotaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Actualizar cita", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fechaHora\": \"2026-11-01T14:00:00.000Z\",\n  \"motivo\": \"Control general actualizado\",\n  \"estado\": \"CONFIRMADA\",\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarioId\": {{veterinarioId}}\n}" }, "url": "{{baseUrl}}/api/v1/citas/{{citaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Actualizar historia clínica", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fecha\": \"2026-11-01\",\n  \"diagnostico\": \"Buen estado general\",\n  \"tratamiento\": \"Control preventivo\",\n  \"observaciones\": \"Seguimiento actualizado\",\n  \"mascotaId\": {{mascotaId}},\n  \"veterinarioId\": {{veterinarioId}},\n  \"citaId\": {{citaId}}\n}" }, "url": "{{baseUrl}}/api/v1/historias-clinicas/{{historiaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Eliminar historia clínica", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/historias-clinicas/{{historiaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Eliminar cita", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/citas/{{citaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Eliminar mascota", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/mascotas/{{mascotaId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Eliminar veterinario", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/veterinarios/{{veterinarioId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] },
        { "name": "Eliminar cliente", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/clientes/{{clienteId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.response.to.have.status(200);"] } }] }
